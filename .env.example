# Copy to .env for local runs. .env is git-ignored.

# --- Secrets (environment only, never in config.yaml) ---
PIWIK_CLIENT_ID=replace-me
PIWIK_CLIENT_SECRET=replace-me

# Google auth, in priority order:
#   1. GCP_SERVICE_ACCOUNT_KEY  = the service account JSON *content* (CI)
#   2. GOOGLE_APPLICATION_CREDENTIALS = path to a key file (local)
#   3. Application Default Credentials (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# --- Optional overrides for config.yaml ---
# GCP_PROJECT=my-gcp-project
# BQ_DATASET=web_analytics
# GA4_PROPERTY_ID=123456789
# PIWIK_HOST=your-account.example.com
# PIWIK_APP_ID=00000000-0000-0000-0000-000000000000
# PIWIK_TIMEZONE=+03:00
